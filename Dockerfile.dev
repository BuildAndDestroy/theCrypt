# Self-contained dev build (no Tor). Unprivileged nginx (non-root, port 8080).
# The website source is bind-mounted at runtime (see docker-compose.yml) so
# HTML/CSS/JS edits are live. Only the third-party vendor assets are baked in,
# from pinned npm dist.

# ---- Stage 1: fetch vendor assets ----
FROM node:22-slim AS vendor

WORKDIR /vendor
RUN npm install --no-save \
    bootstrap@5.3.3 \
    bootstrap-icons@1.11.3

# ---- Stage 2: unprivileged nginx ----
FROM nginxinc/nginx-unprivileged:1.27-alpine

USER root

# Bootstrap JS/CSS -> /opt/vendor/dist  (served at /dist/ by nginx-dev.conf)
COPY --from=vendor /vendor/node_modules/bootstrap/dist /opt/vendor/dist
# Bootstrap Icons  -> /opt/vendor/font  (served at /font/)
COPY --from=vendor /vendor/node_modules/bootstrap-icons/font /opt/vendor/font

COPY nginx-hardening.conf /etc/nginx/snippets/crypt-hardening.conf
COPY nginx-dev.conf /etc/nginx/conf.d/default.conf

# Fallback copy of the site if run without the bind-mount; the mount
# overlays this at runtime for live editing.
COPY website/ /usr/share/nginx/html/

USER 101

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1

EXPOSE 8080
