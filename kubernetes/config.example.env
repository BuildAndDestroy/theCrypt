# Copy to kubernetes/config.env (gitignored) and edit. Read by kubernetes/scripts/*.sh
# Secrets (passwords, keys) do NOT go here — see kubernetes/scripts/secrets.sh.

NAMESPACE=tor-hidden-ns

# MongoDB NFS export (static PV) — writable by UID/GID 999
MONGO_NFS_SERVER=192.0.2.10
MONGO_NFS_PATH=/volume1/thecrypt-db

# Node that runs mongo:7 (needs ARMv8.2+, i.e. a Pi 5). Empty = use the
# thecrypt.io/mongo=true node label instead.
MONGO_NODE=

# Registry + image tags
REGISTRY=registry.example.com
WEBSITE_TAG=1.0.0
CHAT_API_TAG=1.0.0
TOR_TAG=1.0.0
# Platform for build-push.sh (buildx). Optional builder name.
PLATFORM=linux/arm64
BUILDX_BUILDER=

# Registry pull secret (myregistrykey). Leave empty if it already exists.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Onion key directory, used only if the onion-key Secret doesn't exist yet.
ONION_KEY_DIR=tor/hidden_service

# kubectl context (optional; empty = current context)
# KUBECONFIG=/path/to/k3s.yaml

# Field encryption (email / phone / message bodies; key in the chat-data-key
# Secret, see secrets.sh). true refuses legacy plaintext rows. Set false ONLY
# while upgrading from a pre-encryption release (upgrade-encryption.sh does
# this and sets it back to true once migrate.js has encrypted everything).
STRICT_ENCRYPTION=true

# TLS between chat-api and MongoDB (private CA: kubernetes/scripts/mongo-tls.sh).
# Turn on in stages on a running site with kubernetes/scripts/upgrade-mongo-tls.sh.
#   MONGO_TLS_MODE  mongod: disabled | allowTLS | preferTLS | requireTLS
#                   (anything but disabled needs the mongo-tls Secret)
#   MONGO_TLS       chat-api connects with TLS: true | false
#                   (true needs MONGO_TLS_MODE other than disabled)
# Fresh install with TLS from day one: MONGO_TLS_MODE=requireTLS, MONGO_TLS=true,
# after `mongo-tls.sh generate`.
MONGO_TLS_MODE=disabled
MONGO_TLS=false
