# Copy to kubernetes/config.env (gitignored) and edit. Read by kubernetes/scripts/*.sh
# Secrets (passwords, keys) do NOT go here — see kubernetes/scripts/secrets.sh.

NAMESPACE=tor-hidden-ns

# MongoDB NFS export (static PV) — writable by UID/GID 999
MONGO_NFS_SERVER=192.0.2.10
MONGO_NFS_PATH=/volume1/thecrypt-db

# Node that runs mongo:7 (needs ARMv8.2+, i.e. a Pi 5). Empty = use the
# thecrypt.io/mongo=true node label instead.
MONGO_NODE=

# Registry + image tags
REGISTRY=registry.example.com
WEBSITE_TAG=1.0.0
CHAT_API_TAG=1.0.0
TOR_TAG=1.0.0
# Platform for build-push.sh (buildx). Optional builder name.
PLATFORM=linux/arm64
BUILDX_BUILDER=

# Registry pull secret (myregistrykey). Leave empty if it already exists.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Onion key directory, used only if the onion-key Secret doesn't exist yet.
ONION_KEY_DIR=tor/hidden_service

# kubectl context (optional; empty = current context)
# KUBECONFIG=/path/to/k3s.yaml
